# =============================================================================
# Lemonade-Nexus Environment Configuration
# =============================================================================
# Reference for the SP_* environment variables read by lemonade-nexus.
#
# For the packaged service, put deliberate operator overrides in
# /etc/lemonade-nexus/lemonade-nexus.env (loaded via EnvironmentFile).
#
# Precedence (highest first): environment variables, then CLI arguments,
# then the JSON config file, then defaults. Two exceptions:
#   - an explicit --root-pubkey / --genesis-pubkey on the command line wins
#     over SP_ROOT_PUBKEY / SP_GENESIS_PUBKEY (the env value is ignored with
#     a warning);
#   - SP_SEED_PEERS appends to the configured seed list, it does not replace
#     it.
#
# Boolean flags: set to any value to enable.
# =============================================================================

# --- Core ---
SP_DATA_ROOT=./data
SP_LOG_LEVEL=info
# SP_JWT_SECRET=  # empty = auto-generate and persist in the data root

# --- Network Ports ---
# All ports are configurable. Change these to avoid conflicts.
SP_HTTP_PORT=9100
SP_UDP_PORT=51940        # mesh + hole-punch (shared UDP port)
SP_GOSSIP_PORT=9102
SP_STUN_PORT=3478
SP_RELAY_PORT=9103
SP_DNS_PORT=5335
# DNS port advertised to clients in _config TXT records. A firewall/NAT maps
# public 53 -> this local port (both UDP and TCP) on DNS-serving nodes.
SP_PUBLIC_DNS_PORT=53
SP_PRIVATE_HTTP_PORT=9101
SP_BIND_ADDRESS=0.0.0.0
# SP_PUBLIC_IP=     # public IP advertised in DNS (auto-detected if unset)
# SP_REGION=        # cloud region label (auto-detected if unset)

# --- Trust Anchors (required for a normal daemon start) ---
# Hex-encoded Ed25519 public key of the root management server.
# On the genesis server this is the "Identity pubkey" printed by --first-run.
# Generate a fresh root keypair with: python3 scripts/generate_root_keypair.py
SP_ROOT_PUBKEY=

# Base64 Ed25519 public key pinning the Genesis bootstrap anchor.
# On the genesis server this is the "Gossip pubkey" printed by --first-run.
SP_GENESIS_PUBKEY=

# Ed25519 public key that verifies signed release manifests (base64).
# Generate with: python3 scripts/generate_release_signing_key.py
SP_RELEASE_SIGNING_PUBKEY=

# --- WebAuthn ---
SP_RP_ID=lemonade-nexus.local

# --- Gossip / Mesh ---
# Comma-separated list of seed peers (host:port). APPENDED to the seed list
# from the config file / --seed-peer.
# SP_SEED_PEERS=10.0.0.2:9102,10.0.0.3:9102

# --- GitHub Manifest Fetching (older version support) ---
# SP_GITHUB_RELEASES_URL=https://api.github.com/repos/OWNER/REPO/releases
# SP_MANIFEST_FETCH_INTERVAL=3600
# SP_MINIMUM_VERSION=1.0.0
# Optional GitHub token for private repos / higher rate limits
# SP_GITHUB_TOKEN=

# --- ACME / TLS Certificates ---
# Provider: letsencrypt, letsencrypt_staging, or zerossl
SP_ACME_PROVIDER=letsencrypt
# SP_ACME_EAB_KID=
# SP_ACME_EAB_HMAC_KEY=

# --- DNS ---
SP_DNS_PROVIDER=local
SP_DNS_BASE_DOMAIN=lemonade-nexus.io
# SP_DNS_NS_HOSTNAME=ns1.example.com
# Auto-discover seed peers from tier/region DNS records on startup
# (tierN.<region>.seip.<domain>). Set to 0 to require manual --seed-peer.
SP_DNS_SEED_DISCOVERY=1

# --- Dynamic DNS ---
# SP_DDNS_ENABLED=1
# SP_DDNS_DOMAIN=example.com
# SP_DDNS_PASSWORD=

# =============================================================================
# Retired settings (do not use; they are not read):
#   SP_REQUIRE_TEE, SP_TEE_PLATFORM, SP_REQUIRE_ATTESTATION,
#   SP_REQUIRE_PEER_CONFIRMATION, SP_ENROLLMENT_QUORUM
# Attestation and admission are protocol behavior, not environment switches;
# the old governance/root-rotation settings are retired.
# =============================================================================
