<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Required for the mesh dataplane: bind() on its UDP socket fails with
	     EPERM in the App Sandbox without it, so the mesh never comes up. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Required for the Keychain-backed secure store (Cluster keyring + session).
	     Without it a sandboxed app gets errSecMissingEntitlement (-34018) and
	     cannot persist Cluster keys. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.lemonade.nexus.client</string>
	</array>
	<!-- The SDK keeps the per-user device identity in
	     ~/Library/Application Support/LemonadeNexus/, shared with lemond and
	     the Lemonade tray. The sandbox redirects HOME into the app container,
	     so that one folder needs an explicit read-write exception. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/LemonadeNexus/</string>
	</array>
</dict>
</plist>
