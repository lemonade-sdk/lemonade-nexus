#!/usr/bin/env bash
#
# nexus-release-ingest
#
# Operator check: verify that release artifacts came from this repository's
# release workflow on main. nexus-updater runs the same check on each server
# before it stages a release (with a pinned Sigstore trusted root, offline);
# this tool lets an operator repeat it with gh. It signs nothing, touches no
# key material, deploys nothing, and never trusts a repository or workflow
# named by the artifact itself.
#
# release.yml runs only by workflow_dispatch from main, so the signer
# identity is the workflow file at refs/heads/main, not at the tag.
#
# Usage:
#   nexus-release-ingest --repo lemonade-sdk/lemonade-nexus \
#       [--workflow release.yml] [--ref refs/heads/main] <artifact> [<artifact>...]
#
# Requires: gh (authenticated), sha256sum.

set -euo pipefail

REPO="" WORKFLOW="release.yml" REF="refs/heads/main"
ARTIFACTS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --repo)     REPO="$2"; shift 2 ;;
        --workflow) WORKFLOW="$2"; shift 2 ;;
        --ref)      REF="$2"; shift 2 ;;
        -*)         echo "nexus-release-ingest: unknown option $1" >&2; exit 2 ;;
        *)          ARTIFACTS+=("$1"); shift ;;
    esac
done
if [ -z "$REPO" ] || [ "${#ARTIFACTS[@]}" -eq 0 ]; then
    echo "usage: nexus-release-ingest --repo <owner/repo> [--workflow <file>] [--ref <ref>] <artifact>..." >&2
    exit 2
fi

command -v gh >/dev/null || { echo "nexus-release-ingest: gh is required" >&2; exit 2; }

status=0
for artifact in "${ARTIFACTS[@]}"; do
    [ -f "$artifact" ] || { echo "MISSING  $artifact" >&2; status=1; continue; }
    sha="$(sha256sum "$artifact" | awk '{print $1}')"
    # The signer identity must be this repo's release workflow on the release
    # ref; a generic repository build or another ref is not an official release.
    if gh attestation verify "$artifact" \
            --repo "$REPO" \
            --signer-workflow "${REPO}/.github/workflows/${WORKFLOW}@${REF}" \
            >/dev/null 2>&1; then
        echo "PASS     $sha  $artifact"
    else
        echo "FAIL     $sha  $artifact" >&2
        status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo "nexus-release-ingest: verification FAILED; do not sign or deploy these artifacts" >&2
fi
exit "$status"
