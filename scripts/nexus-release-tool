#!/usr/bin/env python3
"""Release workflow helpers. None of them reads or writes key material.

  next-tag     Pick the date tag and release number for today.
  previous     Pick the previous release: the newest date-tagged release, or
               detect the bootstrap release when none exists.
  release-number  Print the release number of a tag.
  spec         Write the nexus-release-bundle spec from release/fleet-profile.json.
  libraries    Check that the server binaries need exactly the shared libraries
               that release/fleet-profile.json pins.
  boot-chain   Decide whether the OS package lock changes the boot chain, and
               check that the profile's PCRs agree with that decision.
  assemble     Put the release signature and the Genesis delegation into the
               unsigned approval bundle.
  manifest     Write manifest.json for nexus-updater.

See docs/Releasing.md. Requires Python 3.8+ only.
"""

import argparse
import datetime
import hashlib
import json
import os
import re
import subprocess
import sys

TAG_RE = re.compile(r"^v(\d{4})\.(\d{2})\.(\d{2})(?:\.([1-9]\d?))?$")
HEX40 = re.compile(r"^[0-9a-f]{40}$")
HEX64 = re.compile(r"^[0-9a-f]{64}$")
HEX96 = re.compile(r"^[0-9a-f]{96}$")
KERNEL_HASHES = ("bzimage_sha256", "vmlinux_sha256", "module_tree_sha256",
                 "module_certificate_der_sha256")
SWAPPABLE = ("/usr/bin/lemonade-nexus", "/usr/bin/nexus-attestd")
UPDATER_PATH = "/usr/bin/nexus-updater"


def fail(message):
    print(f"nexus-release-tool: {message}", file=sys.stderr)
    sys.exit(1)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def load_json(path):
    with open(path, "rb") as f:
        return json.load(f)


def write_json(path, value):
    with open(path, "w", encoding="utf-8") as f:
        json.dump(value, f, indent=2, sort_keys=False)
        f.write("\n")


def release_number(tag):
    m = TAG_RE.match(tag)
    if not m:
        fail(f"{tag} is not a release tag")
    y, mo, d, n = m.groups()
    datetime.date(int(y), int(mo), int(d))  # raises on an invalid date
    seq = int(n) if n else 1
    if n == "1":
        fail(f"{tag}: the first release of a day has no suffix")
    return (int(y) * 10000 + int(mo) * 100 + int(d)) * 100 + seq


def load_profile(path):
    p = load_json(path)
    if p.get("format_version") != 1:
        fail("fleet profile: unsupported format_version")
    for key in ("network_id", "release_signer", "authority_genesis_signature",
                "qualification_state", "expected_pcrs", "source_commit",
                "starting_patched_tree", "ima_policy", "kernel", "svsm_launch_measurements",
                "system_libraries"):
        if key not in p:
            fail(f"fleet profile: missing {key}")
    # The boot line (Design-Auto-Update Phase 0.3): servers verify it against
    # the signed approval only, so the reviewed profile is its sole source.
    if not HEX40.match(p["source_commit"]) or not HEX40.match(p["starting_patched_tree"]):
        fail("fleet profile: source_commit and starting_patched_tree are 40 lowercase hex")
    ima = p["ima_policy"]
    if not ima.get("id") or not HEX64.match(ima.get("sha256", "")):
        fail("fleet profile: ima_policy needs an id and a SHA-256")
    kernel = p["kernel"]
    if not kernel.get("release") or \
            not all(HEX64.match(kernel.get(k, "")) for k in KERNEL_HASHES):
        fail("fleet profile: kernel needs a release and four SHA-256 values")
    if not p["svsm_launch_measurements"] or \
            not all(HEX96.match(m) for m in p["svsm_launch_measurements"]):
        fail("fleet profile: svsm_launch_measurements are 96 lowercase hex, at least one")
    if not HEX64.match(p["network_id"]):
        fail("fleet profile: network_id is not 64 lowercase hex")
    if p["qualification_state"] == "LIVE_BOOT_APPROVED":
        idx = [e.get("index") for e in p["expected_pcrs"]]
        if idx != [8, 9] or not all(HEX64.match(e.get("sha256", "")) for e in p["expected_pcrs"]):
            fail("fleet profile: a qualified profile pins exactly SHA-256 PCR 8 and 9")
    for lib in p["system_libraries"]:
        if not lib.get("path", "").startswith("/") or not lib.get("sha256") or \
                not all(HEX64.match(h) for h in lib["sha256"]):
            fail(f"fleet profile: invalid system library entry {lib!r}")
    return p


def cmd_next_tag(args):
    date = args.date or datetime.datetime.now(datetime.timezone.utc).strftime("%Y.%m.%d")
    with open(args.existing_tags, encoding="utf-8") as f:
        existing = {line.strip() for line in f if line.strip()}
    base = f"v{date}"
    tag = base
    seq = 1
    while tag in existing:
        seq += 1
        if seq > 99:
            fail("more than 99 releases today")
        tag = f"{base}.{seq}"
    print(f"tag={tag}")
    print(f"version={tag[1:]}")
    print(f"release_number={release_number(tag)}")


def cmd_previous(args):
    """The newest published date-tagged release, and whether it is the first.

    The vX.Y.Z-alpha releases predate the release workflow and the approval
    chain; they are never a previous release.

    The bootstrap release (Design-Auto-Update Phase 6) is detected, never
    switched on: it is the release with no earlier date-tagged release and no
    bootstrap marker (release/bootstrap-complete). It has no previous release.
    A date tag without a published release, or a marker without any
    date-tagged release, is a contradiction and fails.
    """
    with open(args.tags, encoding="utf-8") as f:
        tags = [line.strip() for line in f if TAG_RE.match(line.strip())]
    numbered = sorted((release_number(t), t) for t in tags)
    limit = release_number(args.before) if args.before else None
    if limit is not None:
        numbered = [(n, t) for n, t in numbered if n < limit]
    bootstrap = not numbered
    if bootstrap:
        if args.all_tags:
            with open(args.all_tags, encoding="utf-8") as f:
                stray = sorted(t for t in (line.strip() for line in f)
                               if TAG_RE.match(t) and (limit is None or release_number(t) < limit))
            if stray:
                fail(f"date tag {stray[-1]} exists without a published release; "
                     "this is not the bootstrap release")
        if os.path.exists(args.bootstrap_marker):
            fail(f"{args.bootstrap_marker} exists but no date-tagged release is published; "
                 "this is not the bootstrap release")
    tag = numbered[-1][1] if numbered else ""
    print(f"tag={tag}")
    print(f"release_number={numbered[-1][0] if numbered else ''}")
    print(f"is_first={'true' if len(numbered) == 1 else 'false'}")
    print(f"bootstrap={'true' if bootstrap else 'false'}")


def cmd_release_number(args):
    print(release_number(args.tag))


def cmd_spec(args):
    profile = load_profile(args.profile)
    spec = {
        "release_id": args.tag,
        "nexus_version": args.tag[1:],
        "release_number": release_number(args.tag),
        "final_patched_tree": args.tree,
        "network_id": profile["network_id"],
        "signer_pubkey": profile["release_signer"],
        "qualification_state": profile["qualification_state"],
        "expected_pcrs": profile["expected_pcrs"],
        "source_commit": profile["source_commit"],
        "starting_patched_tree": profile["starting_patched_tree"],
        "ima_policy": {"id": profile["ima_policy"]["id"],
                       "sha256": profile["ima_policy"]["sha256"]},
        "kernel": {k: profile["kernel"][k] for k in ("release",) + KERNEL_HASHES},
        "svsm_launch_measurements": profile["svsm_launch_measurements"],
        "artifacts": [
            {"path": "/usr/bin/lemonade-nexus", "file": args.nexus},
            {"path": "/usr/bin/nexus-attestd", "file": args.attestd},
        ] + [{"path": lib["path"], "sha256": lib["sha256"]}
             for lib in profile["system_libraries"]],
    }
    write_json(args.out, spec)


def needed_libraries(binary):
    """The DT_NEEDED entries of an ELF file, read with binutils readelf."""
    try:
        out = subprocess.run(["readelf", "-d", "--wide", binary], check=True,
                             capture_output=True, text=True).stdout
    except (OSError, subprocess.CalledProcessError) as e:
        fail(f"readelf failed on {binary}: {e}")
    needed = re.findall(r"\(NEEDED\)\s+Shared library: \[([^\]]+)\]", out)
    if not needed:
        fail(f"{binary} has no NEEDED entries; is it a dynamic ELF file?")
    return needed


def cmd_libraries(args):
    """Check the binaries' shared libraries against the profile.

    The approval requires each system_libraries path in the IMA log, and the
    attestation profile pins the hash of each one. A NEEDED library that the
    profile does not list would load unpinned code; a listed library that no
    binary needs would never be measured, and every server would fail
    attestation. A NEEDED soname matches the file name of a pinned path, so a
    library whose real file name is not its soname fails the check.
    """
    profile = load_profile(args.profile)
    pinned = {os.path.basename(lib["path"]) for lib in profile["system_libraries"]}
    used = set()
    for binary in args.binary:
        needed = needed_libraries(binary)
        print(f"{binary}: {' '.join(needed)}")
        unpinned = sorted(set(needed) - pinned)
        if unpinned:
            fail(f"{binary} needs shared libraries that release/fleet-profile.json does not "
                 f"pin: {', '.join(unpinned)}")
        used.update(needed)
    unused = sorted(pinned - used)
    if unused:
        fail(f"release/fleet-profile.json pins libraries that no server binary needs: "
             f"{', '.join(unused)}")


def boot_packages(lock_path):
    packages = {}
    if not lock_path or not os.path.exists(lock_path):
        return None
    with open(lock_path, encoding="utf-8") as f:
        for line in f:
            words = line.split()
            if len(words) == 4 and words[0] == "package" and words[3] == "boot":
                packages[words[1]] = words[2]
    return packages


def cmd_boot_chain(args):
    profile = load_profile(args.profile)
    current = boot_packages(args.lock)
    if current is None:
        fail(f"{args.lock} is missing")
    previous = boot_packages(args.previous_lock)
    changed = previous is not None and previous != current
    if args.previous_approval and os.path.exists(args.previous_approval):
        old = load_json(args.previous_approval)["approval"].get("expected_pcrs", [])
        pcrs_changed = old != profile["expected_pcrs"]
        if changed and not pcrs_changed:
            fail("the lock changes a boot package but release/fleet-profile.json keeps the "
                 "previous PCR 8/9; measure the new boot chain on the reference VM first")
        if pcrs_changed and not changed:
            fail("release/fleet-profile.json changes PCR 8/9 but the lock changes no boot package")
    print(f"boot_chain_changed={'true' if changed else 'false'}")


def cmd_assemble(args):
    profile = load_profile(args.profile)
    bundle = load_json(args.bundle)
    with open(args.signature, encoding="ascii") as f:
        signature = f.read().strip()
    authority = bundle["authority"]
    approval = bundle["approval"]
    if authority["network_id"] != profile["network_id"] or \
            authority["release_signing_pubkey"] != profile["release_signer"] or \
            approval["signer_pubkey"] != profile["release_signer"]:
        fail("the bundle does not name the profile's network and release signer")
    authority["genesis_signature"] = profile["authority_genesis_signature"]
    approval["signature"] = signature
    write_json(args.out, bundle)


def cmd_manifest(args):
    approval = load_json(args.approval)["approval"]
    with open(args.approval_preimage, "rb") as f:
        digest = hashlib.sha256(f.read()).hexdigest()
    files = []
    for spec in args.server_file:
        asset, path, file_path = spec.split("=", 2)
        if path not in SWAPPABLE:
            fail(f"{path} is not a path nexus-updater replaces")
        files.append({"asset": asset, "path": path, "sha256": sha256_file(file_path)})
    approved = {p["path"]: p["sha256"] for p in approval["approved_paths"]}
    for f in files:
        if approved.get(f["path"], [None])[0] != f["sha256"]:
            fail(f"the approval does not list {f['path']} with the built hash first")
    updater = None
    if args.updater_file:
        asset, path, file_path = args.updater_file.split("=", 2)
        if path != UPDATER_PATH:
            fail(f"{path} is not the path nexus-updater installs itself at")
        updater = {"asset": asset, "path": path, "sha256": sha256_file(file_path)}
    artifacts = []
    for name in sorted(os.listdir(args.artifacts_dir)):
        full = os.path.join(args.artifacts_dir, name)
        if os.path.isfile(full):
            artifacts.append({"name": name, "sha256": sha256_file(full)})
    manifest = {
        "format_version": 1,
        "repository": args.repository,
        "tag": args.tag,
        "version": args.tag[1:],
        "release_number": release_number(args.tag),
        "source_commit": args.commit,
        "approval": {
            "asset": os.path.basename(args.approval),
            "sha256": sha256_file(args.approval),
            "digest": digest,
        },
        "server_files": files,
        "os_packages": {
            "asset": os.path.basename(args.lock),
            "sha256": sha256_file(args.lock),
            "boot_chain_changed": args.boot_chain_changed == "true",
        },
        "wire": {
            "security_wire_version": approval["security_wire_version"],
            "security_ruleset": approval["security_ruleset"],
            "consensus_ruleset": approval["consensus_ruleset"],
            "attestation_profile_ruleset": approval["attestation_profile_ruleset"],
            "attestd_wire_version": approval["attestd_wire_version"],
        },
        "artifacts": artifacts,
    }
    if updater:
        manifest["updater"] = updater
    if approval["release_id"] != args.tag:
        fail("the approval release_id is not the tag")
    write_json(args.out, manifest)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("next-tag")
    p.add_argument("--existing-tags", required=True, help="file with one tag per line")
    p.add_argument("--date", help="YYYY.MM.DD (default: today, UTC)")
    p.set_defaults(func=cmd_next_tag)

    p = sub.add_parser("previous")
    p.add_argument("--tags", required=True, help="file with one published tag per line")
    p.add_argument("--before", help="only releases older than this tag")
    p.add_argument("--all-tags", help="file with every v* tag of the repository, one per line")
    p.add_argument("--bootstrap-marker", default="release/bootstrap-complete",
                   help="the reviewed file that records the bootstrap release as installed")
    p.set_defaults(func=cmd_previous)

    p = sub.add_parser("release-number")
    p.add_argument("--tag", required=True)
    p.set_defaults(func=cmd_release_number)

    p = sub.add_parser("spec")
    p.add_argument("--profile", required=True)
    p.add_argument("--tag", required=True)
    p.add_argument("--tree", required=True, help="git rev-parse HEAD^{tree}")
    p.add_argument("--nexus", required=True)
    p.add_argument("--attestd", required=True)
    p.add_argument("--out", required=True)
    p.set_defaults(func=cmd_spec)

    p = sub.add_parser("libraries")
    p.add_argument("--profile", required=True)
    p.add_argument("--binary", action="append", required=True,
                   help="a server binary to check (repeat for each)")
    p.set_defaults(func=cmd_libraries)

    p = sub.add_parser("boot-chain")
    p.add_argument("--profile", required=True)
    p.add_argument("--lock", required=True)
    p.add_argument("--previous-lock")
    p.add_argument("--previous-approval")
    p.set_defaults(func=cmd_boot_chain)

    p = sub.add_parser("assemble")
    p.add_argument("--profile", required=True)
    p.add_argument("--bundle", required=True)
    p.add_argument("--signature", required=True)
    p.add_argument("--out", required=True)
    p.set_defaults(func=cmd_assemble)

    p = sub.add_parser("manifest")
    p.add_argument("--repository", required=True)
    p.add_argument("--tag", required=True)
    p.add_argument("--commit", required=True)
    p.add_argument("--approval", required=True)
    p.add_argument("--approval-preimage", required=True)
    p.add_argument("--lock", required=True)
    p.add_argument("--boot-chain-changed", choices=("true", "false"), required=True)
    p.add_argument("--server-file", action="append", required=True,
                   help="asset=/install/path=local/file")
    p.add_argument("--updater-file",
                   help="asset=/usr/bin/nexus-updater=local/file; the updater installs it "
                        "over itself after the health gate")
    p.add_argument("--artifacts-dir", required=True)
    p.add_argument("--out", required=True)
    p.set_defaults(func=cmd_manifest)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
