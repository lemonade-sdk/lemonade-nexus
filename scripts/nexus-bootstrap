#!/usr/bin/env bash
#
# nexus-bootstrap — prepare a packaged Lemonade Nexus server for first start.
#
# Turns a fresh install into a node that can pass config validation:
#
#     package install  ->  nexus-bootstrap  ->  systemctl start lemonade-nexus
#
# It initializes the identity if there is none, reads back the keys the server
# generated, and writes /var/lib/lemonade-nexus/lemonade-nexus.json — the
# packaged source of truth. The service itself takes no arguments; everything it
# needs comes from that file.
#
# The release-signing public key is REQUIRED input. This script never generates
# one and never invents a stand-in: that key belongs to whoever signs releases,
# and a node that trusts a key nobody signs with can approve no binary at all.
# --test-release-key exists only so a throwaway mesh can pass validation, and it
# says so in the file it writes.
#
set -euo pipefail

BIN="${NEXUS_BIN:-/usr/bin/lemonade-nexus}"
STATE_DIR="${NEXUS_STATE_DIR:-/var/lib/lemonade-nexus}"
DATA_ROOT="${NEXUS_DATA_ROOT:-$STATE_DIR/data}"
CONFIG="$STATE_DIR/lemonade-nexus.json"
SERVICE_USER="${NEXUS_USER:-lemonade-nexus}"

RELEASE_KEY=""
TEST_RELEASE_KEY=0
PUBLIC_IP=""
LOG_LEVEL="info"
ACME_PROVIDER="letsencrypt"
DNS_PORT=5335
PUBLIC_DNS_PORT=53
REGION=""
DDNS_ENABLED="false"
FORCE=0

die() { printf 'nexus-bootstrap: %s\n' "$*" >&2; exit 1; }
say() { printf 'nexus-bootstrap: %s\n' "$*"; }

usage() {
    cat <<'USAGE'
Usage: nexus-bootstrap --release-signing-pubkey <hex|base64> [options]
       nexus-bootstrap --test-release-key [options]

Required (one of):
  --release-signing-pubkey KEY  Ed25519 public key your release manifests are
                                signed with. Not generated here.
  --test-release-key            Throwaway meshes only. Reuses the node identity
                                as the release-signing key so validation passes.
                                No manifest is signed by it, so no binary is ever
                                approved through it. The written config is marked.

Options:
  --public-ip ADDR              Public IP to advertise. Default: auto-detect at runtime.
  --log-level LEVEL             trace|debug|info|warn|error. Default: info.
  --acme-provider NAME          letsencrypt | letsencrypt_staging | zerossl.
                                Default: letsencrypt.
  --dns-port PORT               Local DNS bind port. Default: 5335.
  --public-dns-port PORT        DNS port advertised to clients. Default: 53.
                                Requires a 53 -> dns-port mapping; see below.
  --region CODE                 Cloud region (e.g. us-east). Default: auto-detect.
  --ddns-enabled                Enable dynamic DNS updates. Default: disabled.
  --force                       Rewrite an existing config.
  -h, --help                    This message.

Note: --public-dns-port 53 only advertises 53. Nexus binds --dns-port
unprivileged; a firewall/NAT rule must map public UDP/53 to it. Without that
rule clients are told to use a port nothing answers on.
USAGE
}

while [ $# -gt 0 ]; do
    case "$1" in
        --release-signing-pubkey) RELEASE_KEY="${2:?--release-signing-pubkey needs a value}"; shift 2 ;;
        --test-release-key)       TEST_RELEASE_KEY=1; shift ;;
        --public-ip)              PUBLIC_IP="${2:?--public-ip needs a value}"; shift 2 ;;
        --log-level)              LOG_LEVEL="${2:?--log-level needs a value}"; shift 2 ;;
        --acme-provider)          ACME_PROVIDER="${2:?--acme-provider needs a value}"; shift 2 ;;
        --dns-port)               DNS_PORT="${2:?--dns-port needs a value}"; shift 2 ;;
        --public-dns-port)        PUBLIC_DNS_PORT="${2:?--public-dns-port needs a value}"; shift 2 ;;
        --region)                 REGION="${2:?--region needs a value}"; shift 2 ;;
        --ddns-enabled)           DDNS_ENABLED="true"; shift ;;
        --force)                  FORCE=1; shift ;;
        -h|--help)                usage; exit 0 ;;
        *)                        usage >&2; die "unknown argument '$1'" ;;
    esac
done

[ "$(id -u)" -eq 0 ] || die "must run as root (writes $STATE_DIR and installs config)"
[ -x "$BIN" ] || die "server binary not found at $BIN"
id -u "$SERVICE_USER" >/dev/null 2>&1 || die "service user '$SERVICE_USER' does not exist; install the package first"

if [ "$TEST_RELEASE_KEY" -eq 1 ] && [ -n "$RELEASE_KEY" ]; then
    die "--test-release-key and --release-signing-pubkey are mutually exclusive"
fi
if [ "$TEST_RELEASE_KEY" -eq 0 ] && [ -z "$RELEASE_KEY" ]; then
    usage >&2
    die "a release-signing public key is required; pass --release-signing-pubkey, or --test-release-key for a throwaway mesh"
fi

if [ -e "$CONFIG" ] && [ "$FORCE" -eq 0 ]; then
    die "$CONFIG already exists; pass --force to rewrite it"
fi

# --- state tree -------------------------------------------------------------
install -d -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0750 "$STATE_DIR"
install -d -o "$SERVICE_USER" -g "$SERVICE_USER" -m 0700 "$DATA_ROOT"

# --- identity ---------------------------------------------------------------
# --first-run is idempotent: it reports the existing keys rather than replacing
# them, so re-running this script never rotates an identity.
INIT_LOG="$(mktemp)"
trap 'rm -f "$INIT_LOG"' EXIT
say "initializing identity in $DATA_ROOT"
if ! runuser -u "$SERVICE_USER" -- sh -c "cd '$STATE_DIR' && '$BIN' --data-root '$DATA_ROOT' --first-run" >"$INIT_LOG" 2>&1; then
    sed 's/^/  /' "$INIT_LOG" >&2
    die "--first-run failed"
fi

# "Identity pubkey:  <hex>[  (existing)]"
IDENTITY_PUBKEY="$(sed -n 's/^Identity pubkey: *\([0-9a-fA-F]\{64\}\).*$/\1/p' "$INIT_LOG" | head -1)"
GOSSIP_PUBKEY="$(sed -n 's/^Gossip pubkey: *\([A-Za-z0-9+/=]\{40,\}\).*$/\1/p' "$INIT_LOG" | head -1)"
[ -n "$IDENTITY_PUBKEY" ] || { sed 's/^/  /' "$INIT_LOG" >&2; die "could not read the identity pubkey from --first-run output"; }
[ -n "$GOSSIP_PUBKEY" ]   || { sed 's/^/  /' "$INIT_LOG" >&2; die "could not read the gossip pubkey from --first-run output"; }

# The node identity is the mesh root; the gossip key is the Genesis anchor.
ROOT_PUBKEY="$IDENTITY_PUBKEY"
GENESIS_PUBKEY="$GOSSIP_PUBKEY"

TEST_KEY_NOTE=""
if [ "$TEST_RELEASE_KEY" -eq 1 ]; then
    RELEASE_KEY="$IDENTITY_PUBKEY"
    TEST_KEY_NOTE='  "_release_signing_pubkey_is_a_test_fixture": "Reuses the node identity so config validation passes on a throwaway mesh. No release manifest is signed by this key, so no binary is ever approved through it. Never use this on a real deployment.",'
    say "WARNING: --test-release-key in use; the release-signing key is the node identity"
fi

# --- config -----------------------------------------------------------------
# Written to a temp file in the same directory and renamed, so a reader never
# observes a partial config.
TMP="$(mktemp "$STATE_DIR/.lemonade-nexus.json.XXXXXX")"
{
    printf '{\n'
    [ -n "$TEST_KEY_NOTE" ] && printf '%s\n' "$TEST_KEY_NOTE"
    printf '  "data_root": "%s",\n'              "$DATA_ROOT"
    printf '  "dns_port": %s,\n'                 "$DNS_PORT"
    printf '  "public_dns_port": %s,\n'          "$PUBLIC_DNS_PORT"
    printf '  "log_level": "%s",\n'              "$LOG_LEVEL"
    [ -n "$PUBLIC_IP" ] && printf '  "public_ip": "%s",\n' "$PUBLIC_IP"
    [ -n "$REGION" ]    && printf '  "region": "%s",\n'    "$REGION"
    printf '  "root_pubkey": "%s",\n'            "$ROOT_PUBKEY"
    printf '  "genesis_pubkey": "%s",\n'         "$GENESIS_PUBKEY"
    printf '  "release_signing_pubkey": "%s",\n' "$RELEASE_KEY"
    printf '  "acme_provider": "%s",\n'          "$ACME_PROVIDER"
    printf '  "ddns_enabled": %s\n'              "$DDNS_ENABLED"
    printf '}\n'
} >"$TMP"

chown "$SERVICE_USER:$SERVICE_USER" "$TMP"
chmod 0640 "$TMP"
mv -f "$TMP" "$CONFIG"

say "wrote $CONFIG"
say "  root_pubkey    $ROOT_PUBKEY"
say "  genesis_pubkey $GENESIS_PUBKEY"
say "  dns_port       $DNS_PORT (advertised as $PUBLIC_DNS_PORT)"
if [ "$PUBLIC_DNS_PORT" != "$DNS_PORT" ]; then
    say "  NOTE: clients are told port $PUBLIC_DNS_PORT. Map public UDP/$PUBLIC_DNS_PORT"
    say "        to UDP/$DNS_PORT in the firewall, or set --public-dns-port $DNS_PORT."
fi
say "now run: systemctl start lemonade-nexus"
