# Tier-1 authority probe v1. This profile is loaded from the approved,
# PCR9-measured initramfs before rootfs userspace, then made non-replaceable.
# No generic /etc or /var read rule: every authority input is named below.
profile nexus-tier1-authority-probe /usr/bin/nexus-tier1-authority-probe {
  /usr/bin/nexus-tier1-authority-probe mr,
  /etc/ld.so.cache r,
  /lib/**.so* mr,
  /usr/lib/**.so* mr,

  /var/lib/lemonade-nexus/lemonade-nexus.json r,
  /etc/lemonade-nexus/lemonade-nexus.env r,
  /usr/lib/systemd/system/lemonade-nexus.service r,
  /usr/lib/systemd/system/nexus-attestd.service r,
  /etc/apparmor.d/nexus-tier1-authority-probe r,
  /etc/passwd r,
  /etc/group r,
  /usr/lib/lemonade-nexus/tier1-authority-probe.complete r,
  /run/nexus-attestd/nexus-attestd.sock r,

  /etc/systemd/system/lemonade-nexus.service.d/ r,
  /etc/systemd/system/nexus-attestd.service.d/ r,
  /etc/systemd/system/nexus-attestd.socket.d/ r,
  /etc/systemd/system.attached/lemonade-nexus.service.d/ r,
  /etc/systemd/system.attached/nexus-attestd.service.d/ r,
  /etc/systemd/system.attached/nexus-attestd.socket.d/ r,
  /run/systemd/system/lemonade-nexus.service.d/ r,
  /run/systemd/system/nexus-attestd.service.d/ r,
  /run/systemd/system/nexus-attestd.socket.d/ r,
  /run/systemd/system.attached/lemonade-nexus.service.d/ r,
  /run/systemd/system.attached/nexus-attestd.service.d/ r,
  /run/systemd/system.attached/nexus-attestd.socket.d/ r,
  /usr/local/lib/systemd/system/lemonade-nexus.service.d/ r,
  /usr/local/lib/systemd/system/nexus-attestd.service.d/ r,
  /usr/local/lib/systemd/system/nexus-attestd.socket.d/ r,
  /etc/systemd/system.control/lemonade-nexus.service.d/ r,
  /etc/systemd/system.control/nexus-attestd.service.d/ r,
  /etc/systemd/system.control/nexus-attestd.socket.d/ r,
  /run/systemd/system.control/lemonade-nexus.service.d/ r,
  /run/systemd/system.control/nexus-attestd.service.d/ r,
  /run/systemd/system.control/nexus-attestd.socket.d/ r,
  /run/systemd/transient/lemonade-nexus.service.d/ r,
  /run/systemd/transient/nexus-attestd.service.d/ r,
  /run/systemd/transient/nexus-attestd.socket.d/ r,
  /run/systemd/generator.early/lemonade-nexus.service.d/ r,
  /run/systemd/generator.early/nexus-attestd.service.d/ r,
  /run/systemd/generator.early/nexus-attestd.socket.d/ r,
  /run/systemd/generator/lemonade-nexus.service.d/ r,
  /run/systemd/generator/nexus-attestd.service.d/ r,
  /run/systemd/generator/nexus-attestd.socket.d/ r,
  /run/systemd/generator.late/lemonade-nexus.service.d/ r,
  /run/systemd/generator.late/nexus-attestd.service.d/ r,
  /run/systemd/generator.late/nexus-attestd.socket.d/ r,
  /usr/lib/systemd/system/lemonade-nexus.service.d/ r,
  /usr/lib/systemd/system/nexus-attestd.service.d/ r,
  /usr/lib/systemd/system/nexus-attestd.socket.d/ r,
}
