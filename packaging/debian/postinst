#!/bin/bash
set -e

# Create lemonade-nexus system user if it doesn't exist
if ! id -u lemonade-nexus >/dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin \
        --home-dir /var/lib/lemonade-nexus lemonade-nexus
fi

# The nexus-attestd socket's ACL is membership of group 'nexus'. Create it here
# so the unit's SupplementaryGroups= always resolves, whether or not the
# attestd package is installed yet.
if ! getent group nexus >/dev/null 2>&1; then
    groupadd --system nexus
fi
if ! id -nG lemonade-nexus 2>/dev/null | tr ' ' '\n' | grep -qx nexus; then
    usermod -a -G nexus lemonade-nexus
fi

# The full state tree the service expects. The data root is a separate mode
# because it holds the identity and the wrapped keys; the parent only has to be
# traversable by the service user.
install -d -o lemonade-nexus -g lemonade-nexus -m 0750 /var/lib/lemonade-nexus
install -d -o lemonade-nexus -g lemonade-nexus -m 0700 /var/lib/lemonade-nexus/data
install -d -o root           -g lemonade-nexus -m 0750 /etc/lemonade-nexus

# The server is configured by /var/lib/lemonade-nexus/lemonade-nexus.json, which
# nexus-bootstrap writes. The env file exists only for deliberate operator
# overrides and ships EMPTY: a value here wins over the config file, so shipping
# defaults meant an install silently ran on them.
#
# In particular there is no SP_JWT_SECRET. A configured secret is used verbatim,
# so shipping a placeholder meant every install signed tokens with a value
# published in this file. Left unset, the server generates one on first run and
# persists it to <data_root>/identity/jwt_secret.hex.
if [ ! -f /etc/lemonade-nexus/lemonade-nexus.env ]; then
    cat > /etc/lemonade-nexus/lemonade-nexus.env <<'ENVEOF'
# Lemonade-Nexus operator overrides.
#
# Normal configuration lives in /var/lib/lemonade-nexus/lemonade-nexus.json,
# written by nexus-bootstrap. Anything set here OVERRIDES that file, so leave it
# empty unless you are deliberately overriding a single value.
#
# Do NOT put the bootstrap trust anchors here (root_pubkey, genesis_pubkey,
# release_signing_pubkey). They belong in the config file, in one place.
#
# See .env.example for the full list of SP_* variables.
ENVEOF
fi

chown root:lemonade-nexus /etc/lemonade-nexus/lemonade-nexus.env
chmod 0640 /etc/lemonade-nexus/lemonade-nexus.env

# The unit is enabled but NOT started: it cannot pass config validation until
# nexus-bootstrap has written the config, and Restart=on-failure would turn that
# into a restart loop on a fresh install.
systemctl daemon-reload
systemctl enable lemonade-nexus.service

echo ""
echo "========================================"
echo " Lemonade-Nexus installed"
echo "========================================"
echo ""
echo " Config:  /var/lib/lemonade-nexus/lemonade-nexus.json  (written by bootstrap)"
echo " Data:    /var/lib/lemonade-nexus/data"
echo " Logs:    journalctl -u lemonade-nexus"
echo ""
echo " The service is enabled but not started: it has no configuration yet."
echo " Bootstrap it, then start:"
echo ""
echo "   sudo nexus-bootstrap --release-signing-pubkey <YOUR_RELEASE_KEY>"
echo "   sudo systemctl start lemonade-nexus"
echo ""
echo " nexus-bootstrap --help explains the remaining options."
echo ""
echo "========================================"
