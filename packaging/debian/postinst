#!/bin/bash
set -e

package_is_installed() {
    # This script is also CPack's RPM post-install; rpm hosts have no dpkg-query.
    if command -v dpkg-query >/dev/null 2>&1; then
        dpkg-query -W -f='${Status}\n' "$1" 2>/dev/null |
            grep -qx 'install ok installed'
    elif command -v rpm >/dev/null 2>&1; then
        rpm -q "$1" >/dev/null 2>&1
    else
        return 1
    fi
}

rebuild_supported_initramfs() {
    local have_dracut=0
    local have_initramfs_tools=0
    local rebuilt=0
    local module_dir kernel

    package_is_installed dracut && have_dracut=1
    package_is_installed initramfs-tools && have_initramfs_tools=1

    if [ "$have_dracut" -eq 1 ] && [ "$have_initramfs_tools" -eq 1 ]; then
        echo "lemonade-nexus: both dracut and initramfs-tools are installed; preferring dracut" >&2
        have_initramfs_tools=0
    fi

    if [ "$have_dracut" -eq 1 ]; then
        [ -x /usr/bin/dracut ] || {
            echo "lemonade-nexus: dracut is installed but /usr/bin/dracut is unavailable" >&2
            return 1
        }
        for module_dir in /lib/modules/*; do
            [ -d "$module_dir" ] || continue
            kernel=${module_dir##*/}
            [ -f "/boot/vmlinuz-$kernel" ] || continue
            /usr/bin/dracut --force "/boot/initrd.img-$kernel" "$kernel"
            rebuilt=1
        done
    elif [ "$have_initramfs_tools" -eq 1 ]; then
        [ -x /usr/sbin/update-initramfs ] || {
            echo "lemonade-nexus: initramfs-tools is installed but update-initramfs is unavailable" >&2
            return 1
        }
        /usr/sbin/update-initramfs -u -k all
        rebuilt=1
    else
        echo "lemonade-nexus: no supported initramfs backend is installed (need dracut or initramfs-tools)" >&2
        return 1
    fi

    if [ "$rebuilt" -ne 1 ]; then
        echo "lemonade-nexus: no installed kernel image was available for initramfs rebuild" >&2
        return 1
    fi
}

# The files this package puts into the initramfs. preinst lists the same
# files in the same order.
EARLY_BOOT_INPUTS=(
    /usr/lib/lemonade-nexus/apparmor/nexus-tier1-authority-probe.bin
    /usr/share/initramfs-tools/hooks/nexus-tier1-apparmor
    /usr/share/initramfs-tools/scripts/init-premount/nexus-tier1-apparmor
    /usr/lib/dracut/modules.d/76nexus-tier1-apparmor/module-setup.sh
    /usr/lib/dracut/modules.d/76nexus-tier1-apparmor/nexus-tier1-apparmor.sh
)
EARLY_BOOT_DIGEST=/var/lib/lemonade-nexus/.initramfs-inputs.sha256

# True unless preinst recorded a digest of the previously installed
# early-boot files and the new files have the same digest. A fresh install,
# a reinstall after removal, and an RPM install record no digest.
early_boot_inputs_changed() {
    local recorded current
    [ -f "$EARLY_BOOT_DIGEST" ] && [ ! -L "$EARLY_BOOT_DIGEST" ] || return 0
    recorded=$(cat -- "$EARLY_BOOT_DIGEST") || return 0
    current=$(sha256sum -- "${EARLY_BOOT_INPUTS[@]}" 2>/dev/null) || return 0
    [ "$recorded" != "$current" ]
}

# Create lemonade-nexus system user if it doesn't exist
if ! id -u lemonade-nexus >/dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin \
        --home-dir /var/lib/lemonade-nexus lemonade-nexus
fi

# The nexus-attestd socket's ACL is membership of group 'nexus'. Create it here
# so the unit's SupplementaryGroups= always resolves, whether or not the
# attestd package is installed yet.
if ! getent group nexus >/dev/null 2>&1; then
    groupadd --system nexus
fi
if ! id -nG lemonade-nexus 2>/dev/null | tr ' ' '\n' | grep -qx nexus; then
    usermod -a -G nexus lemonade-nexus
fi

# The nexus-attestd unit runs as its own user (User=Group=nexus-attestd) so a
# compromise of the mesh server does not inherit TPM access and vice versa.
# Create the system account if it is absent, mirroring the lemonade-nexus
# user above.
if ! id -u nexus-attestd >/dev/null 2>&1; then
    groupadd --system nexus-attestd
    useradd --system --no-create-home --shell /usr/sbin/nologin \
        --home-dir /nonexistent --gid nexus-attestd nexus-attestd
fi
# The unit's SupplementaryGroups= lists tss and nexus. tss is provided by
# tpm2-tss and may not exist yet on a fresh install; only add the user to a
# group that is present. Membership is checked the same way as above.
if getent group tss >/dev/null 2>&1; then
    if ! id -nG nexus-attestd 2>/dev/null | tr ' ' '\n' | grep -qx tss; then
        usermod -a -G tss nexus-attestd
    fi
fi
if getent group nexus >/dev/null 2>&1; then
    if ! id -nG nexus-attestd 2>/dev/null | tr ' ' '\n' | grep -qx nexus; then
        usermod -a -G nexus nexus-attestd
    fi
fi

# The config file contains the root and Genesis trust anchors. Release approval
# is separately packaged and must carry a Genesis-delegated authority signature.
# Its parent must be root-owned as well: protecting the file alone would still
# let the daemon replace it by renaming another file into the directory.
# Runtime identity, wrapped keys, certificates, and other mutable state live
# under data, which remains owned by the service user with mode 0700.
# The daemon must not replace trust anchors directly or through their parent.
[ ! -L /var/lib/lemonade-nexus ] || exit 1
install -d -o root -g lemonade-nexus -m 0750 /var/lib/lemonade-nexus
[ ! -L /var/lib/lemonade-nexus/data ] || exit 1
[ ! -L /var/lib/lemonade-nexus/lemonade-nexus.json ] || exit 1
if [ -f /var/lib/lemonade-nexus/lemonade-nexus.json ]; then
    # Changing ownership does not revoke a writable descriptor already open
    # against the old file. Install a new inode and rename it into place so
    # existing descriptors and hard links cannot alter the installed config.
    config_tmp=$(mktemp /var/lib/lemonade-nexus/.lemonade-nexus.json.XXXXXX)
    trap 'rm -f "$config_tmp"' EXIT
    install -o root -g lemonade-nexus -m 0640 /var/lib/lemonade-nexus/lemonade-nexus.json "$config_tmp"
    mv -f "$config_tmp" /var/lib/lemonade-nexus/lemonade-nexus.json
    trap - EXIT
fi
install -d -o lemonade-nexus -g lemonade-nexus -m 0700 /var/lib/lemonade-nexus/data
install -d -o root           -g lemonade-nexus -m 0750 /etc/lemonade-nexus

# The Tier-1 candidate reads trust configuration only from the fixed JSON.
# This required env file is parsed directly by the server, not injected by
# systemd; its only permitted setting is SP_LOG_LEVEL. It ships empty.
#
# In particular there is no SP_JWT_SECRET: under the Tier-1 contract this file
# cannot carry secrets, and any entry besides SP_LOG_LEVEL fails startup. The
# server generates the JWT secret on first run and persists it to
# <data_root>/identity/jwt_secret.hex.
if [ ! -f /etc/lemonade-nexus/lemonade-nexus.env ]; then
    cat > /etc/lemonade-nexus/lemonade-nexus.env <<'ENVEOF'
# Lemonade-Nexus Tier-1 operational override (optional value; file required).
#
# Normal configuration lives in /var/lib/lemonade-nexus/lemonade-nexus.json,
# written by nexus-bootstrap. Only SP_LOG_LEVEL=trace|debug|info|warn|error is
# accepted here. Other entries fail startup under the Tier-1 service contract.
#
# Root and Genesis keys belong only in the protected JSON. Release authority is
# accepted only from the signed packaged release-approval object.
ENVEOF
fi

chown root:lemonade-nexus /etc/lemonade-nexus/lemonade-nexus.env
chmod 0640 /etc/lemonade-nexus/lemonade-nexus.env

# PCR 9 measures the initramfs. The sealed boot set (storage share, gossip
# identity) and the release approval are bound to PCR 8/9, so a rebuilt image
# stops unsealing and attestation at the next boot unless an approval for the
# new values is staged. Rebuild only when this package's early-boot files
# changed; an upgrade or reinstall with the same files keeps the measured
# image.
#
# Rebuild only through the backend selected by installed package state. The
# dependency guarantees a supported backend; dracut wins when both are present,
# and refusing zero prevents an image that silently omits the Tier-1 early
# profile.
if early_boot_inputs_changed; then
    rebuild_supported_initramfs
else
    echo "lemonade-nexus: the early-boot files are unchanged; the measured initramfs is kept"
fi
rm -f "$EARLY_BOOT_DIGEST"

# Enable the unit without starting it. A fresh install has no config until
# nexus-bootstrap runs; starting now would fail validation and trigger the
# unit's failure-restart policy before bootstrap has had a chance to finish.
#
# nexus-dns-nat.service is deliberately left alone. Installing a package must not
# change the host's firewall; its rules only appear once nexus-bootstrap
# --install-dns-nat has written the conf its ConditionPathExists tests for.
systemctl daemon-reload
systemctl enable lemonade-nexus.service

# Every OS change on a fleet server arrives through a release, so its PCR 8/9
# and system library measurements are known before it is installed
# (docs/Design-Auto-Update.md). Distribution-driven upgrades would change them
# without a release, so they are disabled. nexus-updater installs the exact
# versions in release/os-packages.lock instead. Package lists still refresh.
if [ -d /etc/apt/apt.conf.d ]; then
    cat > /etc/apt/apt.conf.d/52lemonade-nexus-no-unattended-upgrades <<'APTEOF'
// Written by the lemonade-nexus package. OS updates arrive through signed
// releases and nexus-updater; see docs/Design-Auto-Update.md.
APT::Periodic::Unattended-Upgrade "0";
APTEOF
    chmod 0644 /etc/apt/apt.conf.d/52lemonade-nexus-no-unattended-upgrades
    for unit in unattended-upgrades.service apt-daily-upgrade.timer; do
        if systemctl list-unit-files "$unit" >/dev/null 2>&1; then
            systemctl disable --now "$unit" >/dev/null 2>&1 || true
        fi
    done
fi

# The updater timer and path unit are enabled, not started; they first run
# after the next boot or an explicit start. The path unit starts a cycle when
# the server touches /run/lemonade-nexus/updater-wake (a rollout started, or
# this server's turn opened); the timer is the fallback.
systemctl enable nexus-updater.timer nexus-updater.path

# The Nexus server wants the attestation daemon but does not require it. If the
# unit shipped by the attestd package is present, enable it the same way: for
# boot, without starting it.
systemctl enable nexus-attestd.service

echo ""
echo "========================================"
echo " Lemonade-Nexus installed"
echo "========================================"
echo ""
echo " Config:  /var/lib/lemonade-nexus/lemonade-nexus.json  (written by bootstrap)"
echo " Data:    /var/lib/lemonade-nexus/data"
echo " Logs:    journalctl -u lemonade-nexus"
echo ""
echo " The service is enabled but not started: it has no configuration yet."
echo " Bootstrap it, then start:"
echo ""
echo "   sudo nexus-bootstrap --install-dns-nat"
echo "   sudo systemctl start lemonade-nexus"
echo ""
echo " --install-dns-nat maps public 53/udp+tcp to the unprivileged DNS port."
echo " Without it the advertised DNS port answers nothing. No firewall rule has"
echo " been installed by this package."
echo ""
echo " nexus-bootstrap --help explains the remaining options."
echo ""
echo "========================================"
