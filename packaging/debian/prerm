#!/bin/bash
set -e

# Stop and disable the service before removal
if systemctl is-active --quiet lemonade-nexus.service; then
    systemctl stop lemonade-nexus.service
fi
systemctl disable lemonade-nexus.service 2>/dev/null || true

# The updater must not start a cycle against a package that is going away.
systemctl stop nexus-updater.timer 2>/dev/null || true
systemctl disable nexus-updater.timer 2>/dev/null || true
